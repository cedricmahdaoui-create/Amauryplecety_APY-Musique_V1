# =========================================================================
#  La Cave aux Instrum' — configuration Apache (mutualisé type OVH, o2switch…)
#  Sécurité, redirections, cache. Adaptez le domaine si besoin.
# =========================================================================

# ----- 1. Forcer HTTPS + www -----------------------------------------------
RewriteEngine On

# http -> https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# domaine nu -> www (adaptez si vous préférez sans www)
RewriteCond %{HTTP_HOST} ^lacaveauxinstrum\.fr$ [NC]
RewriteRule ^ https://www.lacaveauxinstrum.fr%{REQUEST_URI} [R=301,L]

# ----- 2. Pages d'erreur -------------------------------------------------
ErrorDocument 404 /404.html

# ----- 3. En-têtes de sécurité -----------------------------------------
<IfModule mod_headers.c>
    # HSTS : 2 ans, sous-domaines inclus. Ne l'activez qu'une fois le HTTPS stable.
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Politique de sécurité du contenu.
    # 'self' suffit : tout le JS exécutable est externe (/assets/js/main.js).
    # Les blocs <script type="application/ld+json"> sont des données, non soumises à script-src.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"

    # --- Décommenter UNIQUEMENT si l'éditeur en ligne /admin/cms.html est utilisé
    #     (Decap CMS charge un script CDN et dialogue avec GitHub/Netlify) : ---
    # SetEnvIf Request_URI "^/admin/cms" DECAP_CMS
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.github.com https://api.netlify.com https://*.netlify.app https://unpkg.com https://cdn.jsdelivr.net; frame-src https://*.netlify.app; frame-ancestors 'none'" env=DECAP_CMS
    # Et neutraliser la stricte sur ce chemin : ajouter  env=!DECAP_CMS  à la ligne ci-dessus.

    # Anti-clickjacking (complément de frame-ancestors pour les vieux navigateurs)
    Header always set X-Frame-Options "DENY"

    # Empêche le MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Ne fuite pas l'URL complète vers les sites tiers
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Coupe l'accès aux API sensibles du navigateur
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

    # Isolation d'origine
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Retire l'en-tête qui révèle la techno
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Masque la signature du serveur
ServerSignature Off

# ----- 4. Bloquer l'accès aux fichiers sensibles ----------------------
<FilesMatch "(^\.|\.(md|mjs|json|map|log|bak|inc|ini|sh|bat|cmd|ps1|yml|yaml)$)">
    Require all denied
</FilesMatch>
# Dossier des outils de développement (non nécessaire en production)
RedirectMatch 404 ^/tools/
# On ré-autorise les fichiers publics indispensables
<FilesMatch "^(site\.webmanifest|manifest\.json|catalogue\.json|config\.yml)$">
    Require all granted
</FilesMatch>

# Interdire le listing de répertoire
Options -Indexes

# ----- 4 bis. Administration -----------------------------------------
# L'interface /admin/ (Decap CMS) s'authentifie via Netlify Identity : elle peut
# rester publique. Pour la verrouiller quand même en hébergement Apache,
# décommenter et créer un fichier .htpasswd (htpasswd -c /chemin/.htpasswd amaury) :
# <IfModule mod_authn_file.c>
#   <Directory "/chemin/absolu/vers/www/admin">
#     AuthType Basic
#     AuthName "Administration - La Cave aux Instrum"
#     AuthUserFile /chemin/absolu/vers/.htpasswd
#     Require valid-user
#   </Directory>
# </IfModule>

# ----- 5. Cache & compression ---------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# ----- 6. Types MIME -----------------------------------
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
